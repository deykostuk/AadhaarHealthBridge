# ==============================================================================
# 🩺 Aadhaar Health Bridge — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in your environment-specific credentials and secrets.
# 3. CRITICAL: NEVER commit your actual '.env' file into Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # 'development' | 'testing' | 'production'
APP_BASE_URL=http://localhost:5000     # Public domain URL for QR codes and deep links

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS & AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, generate strong 64-character random secrets:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_strong_random_secret_key_here
JWT_SECRET=generate_strong_random_jwt_secret_key_here

# 256-bit Base64 URL-safe Encryption Keys for KMS & Database Field Encryption:
# python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=generate_urlsafe_base64_32_byte_key_here
DATABASE_ENCRYPTION_KEY=generate_urlsafe_base64_32_byte_key_here
KMS_MASTER_KEY_256=generate_urlsafe_base64_32_byte_key_here

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
# If left blank, automatically defaults to local SQLite database (app/app.db)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aadhaar_health_bridge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# 4. TRANSPORT SECURITY & HTTPS / TLS
# ------------------------------------------------------------------------------
ENFORCE_HTTPS=false                    # Set to 'true' in production behind TLS proxy
HSTS_MAX_AGE=63072000                  # 2-year RFC 6797 HSTS preload header
# SSL_CERT_PATH=/path/to/cert.pem      # Optional SSL certificate for direct Uvicorn HTTPS
# SSL_KEY_PATH=/path/to/key.pem        # Optional SSL private key

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED CACHING & RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
# If blank, automatically falls back to in-memory sliding window rate limiting
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 6. LOCAL RAG & AI CLINICAL ASSISTANT (Zero-Cost Local Architecture)
# ------------------------------------------------------------------------------
ALLOW_EXTERNAL_AI_APIS=false           # Strict $0 cost guardrail (blocks cloud LLM billing)
AI_API_MODE=local                      # 'local' | 'cloud'
RAG_MODE=local                         # 'local' | 'cloud'
LLM_PROVIDER=ollama                    # 'ollama' | 'grok' | 'groq'
VECTOR_STORE=auto                      # 'auto' | 'chroma' | 'pgvector'
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=15

# Optional Cloud LLM Keys (Only utilized if ALLOW_EXTERNAL_AI_APIS=true)
XAI_API_KEY=
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 7. CLOUD STORAGE (Optional for Hybrid Mode: Azure Blob / Supabase)
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=health-vault
AZURE_STORAGE_CONNECTION_STRING=

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=health-vault

# ------------------------------------------------------------------------------
# 8. KEY MANAGEMENT SERVICE (HashiCorp Vault / KMS)
# ------------------------------------------------------------------------------
KMS_PROVIDER=local                     # 'local' | 'vault' | 'aws' | 'azure'
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/ahb/encryption-keys
VAULT_TRANSIT_KEY=ahb-master-key
